# FabricAssist development-only placeholders.
# Copy this file to .env for local Docker Compose use.
# These values are intentionally insecure and MUST be replaced outside local development.

FABRICASSIST_ENVIRONMENT=development
FABRICASSIST_LOG_LEVEL=INFO
# Development-only signing secret. Replace outside local development.
FABRICASSIST_ACCESS_TOKEN_SECRET=change-me-local-access-secret-please-replace
FABRICASSIST_ACCESS_TOKEN_MINUTES=15
FABRICASSIST_REFRESH_TOKEN_DAYS=14
FABRICASSIST_DEFAULT_TENANT_SLUG=fabricassist-development
FABRICASSIST_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
FABRICASSIST_UPLOAD_MAX_BYTES=12582912
FABRICASSIST_UPLOAD_URL_MINUTES=10
# Default maximum completed or pending images in one draft scan. Roles may repeat.
FABRICASSIST_MAX_IMAGES_PER_SCAN=8
FABRICASSIST_ANALYSIS_LEASE_MINUTES=5

# Vision analysis defaults to a deterministic local mock: it makes no network calls and
# returns an explicit review-needed result. To use any real provider, put credentials
# only in the ignored .env file; never commit or paste secrets into chat.
FABRICASSIST_VISION_PROVIDER=mock
# FABRICASSIST_VISION_BASE_URL=https://your-openai-compatible-host/v1
# FABRICASSIST_VISION_API_KEY=replace-with-your-secret
# FABRICASSIST_VISION_MODEL=vision-capable-model-id
# Optional JSON object of gateway-specific headers. Keep values in ignored .env.
# FABRICASSIST_VISION_EXTRA_HEADERS_JSON='{"X-Gateway-Subscription-Key":"replace-with-secret"}'
# Reasoning-capable models can require longer than a conventional HTTP request.
FABRICASSIST_VISION_TIMEOUT_SECONDS=120
# Responses models may use output tokens for internal reasoning before emitting
# the small structured extraction. Keep this at the provider-supported maximum.
FABRICASSIST_VISION_MAX_INPUT_TOKENS=128000
FABRICASSIST_VISION_MAX_OUTPUT_TOKENS=16000
# Opt-in local diagnostics: logs the prompt, safe normalized-image metadata, and
# model text output. It never logs image bytes, API keys, headers, or endpoints.
FABRICASSIST_VISION_DEBUG_LOGGING=false

# Trusted product catalog defaults to the deterministic no-network fixture. The
# HTTP adapter requires HTTPS and an explicit comma-separated host allow-list.
FABRICASSIST_PRODUCT_PROVIDER=mock
# FABRICASSIST_PRODUCT_BASE_URL=https://catalog.example/products
# FABRICASSIST_PRODUCT_ALLOWED_HOSTS=catalog.example
# FABRICASSIST_PRODUCT_API_KEY=replace-with-secret
FABRICASSIST_PRODUCT_TIMEOUT_SECONDS=10
FABRICASSIST_PRODUCT_MAX_RESPONSE_BYTES=262144
FABRICASSIST_PRODUCT_CACHE_MINUTES=1440

# Generic OpenAI Responses-compatible gateway example. The provider stays agnostic:
# change only these settings to use a different Responses-compatible gateway/model.
# FABRICASSIST_VISION_PROVIDER=openai_responses
# FABRICASSIST_VISION_BASE_URL=https://your-gateway.example/openai/v1
# FABRICASSIST_VISION_API_KEY=replace-with-your-secret
# FABRICASSIST_VISION_MODEL=your-vision-model-id
# FABRICASSIST_VISION_EXTRA_HEADERS_JSON='{"X-Gateway-Subscription-Key":"replace-with-secret"}'

# Azure OpenAI alternative. Set the provider to azure_openai and fill these only
# in your ignored .env file. Deployment is the Azure deployment name, not merely
# the underlying model name. Never commit or paste the key into a chat.
# FABRICASSIST_VISION_PROVIDER=azure_openai
# FABRICASSIST_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# FABRICASSIST_AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
# FABRICASSIST_AZURE_OPENAI_DEPLOYMENT=your-vision-deployment-name
FABRICASSIST_AZURE_OPENAI_API_VERSION=2024-10-21

# Local PostgreSQL placeholders. Change the user/password/database for any shared environment.
FABRICASSIST_POSTGRES_DB=fabricassist_dev
FABRICASSIST_POSTGRES_USER=fabricassist_dev
FABRICASSIST_POSTGRES_PASSWORD=change-me-local-postgres
FABRICASSIST_POSTGRES_PORT=5432
# Isolated Compose migration-test database; do not use it for application data.
FABRICASSIST_POSTGRES_TEST_PORT=5433
FABRICASSIST_DATABASE_URL=postgresql://fabricassist_dev:change-me-local-postgres@fabricassist-postgres:5432/fabricassist_dev

# Valkey uses no authentication only in this isolated local development stack.
# Configure authentication and TLS outside development.
FABRICASSIST_VALKEY_PORT=6379
FABRICASSIST_VALKEY_URL=valkey://fabricassist-valkey:6379/0

# Local MinIO placeholders. Replace both credentials outside local development.
FABRICASSIST_S3_ENDPOINT_URL=http://fabricassist-minio:9000
# Browser-reachable S3 endpoint used only in presigned URLs.
FABRICASSIST_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
FABRICASSIST_S3_ACCESS_KEY=fabricassist-local
FABRICASSIST_S3_SECRET_KEY=change-me-local-minio
FABRICASSIST_S3_BUCKET=fabricassist-local
FABRICASSIST_S3_FORCE_PATH_STYLE=true
FABRICASSIST_MINIO_API_PORT=9000
FABRICASSIST_MINIO_CONSOLE_PORT=9001
# Isolated MinIO endpoint used by Compose-backed integration tests.
FABRICASSIST_MINIO_TEST_PORT=9002

# Local API values for the Phase 2 backend and Phase 3 Expo diagnostics.
# Change the public URL for a device, web host, or any non-local environment.
FABRICASSIST_API_PORT=8000
FABRICASSIST_API_PUBLIC_URL=http://localhost:8000
