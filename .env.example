# FabricAssist development-only placeholders.
# Copy this file to .env for local Docker Compose use.
# These values are intentionally insecure and MUST be replaced outside local development.

# Runtime environment: development, alpha, or production.
FABRICASSIST_ENVIRONMENT=development
# Deployment topology: local, alpha, or production.
FABRICASSIST_DEPLOYMENT_PROFILE=local
# Capability options:
#   JOB_DISPATCHER=celery (local) | qstash (hosted signed HTTP)
#   HOT_CACHE_BACKEND=valkey | noop
#   RATE_LIMITER_BACKEND=valkey | noop
#   CONCURRENCY_GATE_BACKEND=valkey | noop
# Local Docker uses Celery for jobs and Valkey for optional cache,
# rate-limiting, and worker-concurrency capabilities.
# Job transport: celery or qstash.
FABRICASSIST_JOB_DISPATCHER=celery
# Hot-cache backend: valkey or noop.
FABRICASSIST_HOT_CACHE_BACKEND=valkey
# Rate limiter backend: valkey or noop.
FABRICASSIST_RATE_LIMITER_BACKEND=valkey
# Concurrency gate backend: valkey or noop.
FABRICASSIST_CONCURRENCY_GATE_BACKEND=valkey
# Log level: DEBUG, INFO, WARNING, or ERROR.
FABRICASSIST_LOG_LEVEL=INFO
# Development-only signing secret. Replace outside local development.
# JWT signing secret; use a random 32+ character value outside local development.
FABRICASSIST_ACCESS_TOKEN_SECRET=change-me-local-access-secret-please-replace
# Access-token lifetime in minutes; example: 15.
FABRICASSIST_ACCESS_TOKEN_MINUTES=15
# Refresh-token lifetime in days; example: 14.
FABRICASSIST_REFRESH_TOKEN_DAYS=14
# Development tenant slug; example: fabricassist-development.
FABRICASSIST_DEFAULT_TENANT_SLUG=fabricassist-development
# Frontend origin used for links and CORS; example: http://localhost:8081.
FABRICASSIST_APP_BASE_URL=http://localhost:8081
# Public API base URL; example: http://localhost:8000.
FABRICASSIST_API_PUBLIC_URL=http://localhost:8000
# Comma-separated browser origins; never use * in hosted environments.
FABRICASSIST_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# HSTS max-age; use 0 for local HTTP, positive seconds for HTTPS.
FABRICASSIST_SECURITY_HSTS_SECONDS=31536000
# Metrics are internal-only in production; set a random 32+ character bearer token.
# Expose metrics: true or false.
FABRICASSIST_METRICS_ENABLED=true
# Metrics bearer token; leave empty only for local metrics without auth.
FABRICASSIST_METRICS_ACCESS_TOKEN=
# Leave empty unless the optional observability profile or an OTLP backend is used.
# Optional OTLP collector URL; empty disables export.
FABRICASSIST_OTEL_EXPORTER_OTLP_ENDPOINT=
# OpenTelemetry service name; example: fabricassist-api.
FABRICASSIST_OTEL_SERVICE_NAME=fabricassist-api
# Enable request limits: true or false.
FABRICASSIST_RATE_LIMIT_ENABLED=true
# Development remains usable during Valkey restarts. Production must set false.
# Allow requests when limiter is unavailable; true only for isolated local development.
FABRICASSIST_RATE_LIMIT_FAIL_OPEN=true
# Global requests per minute; example: 600.
FABRICASSIST_RATE_LIMIT_GLOBAL_PER_MINUTE=600
# Authentication requests per minute per client; example: 10.
FABRICASSIST_RATE_LIMIT_AUTH_PER_MINUTE=10
# Analysis requests per minute per client; example: 10.
FABRICASSIST_RATE_LIMIT_ANALYSIS_PER_MINUTE=10
# Chat requests per minute per client; example: 20.
FABRICASSIST_RATE_LIMIT_CHAT_PER_MINUTE=20
# Recent conversation messages included in context; default: 12.
FABRICASSIST_CONVERSATION_RECENT_MESSAGE_LIMIT=12
# Relevant evidence images included in conversation context; default: 8.
FABRICASSIST_CONVERSATION_RELEVANT_IMAGE_LIMIT=8
# Maximum worker jobs process-wide; example: 8.
FABRICASSIST_WORKER_GLOBAL_CONCURRENCY=8
# Maximum simultaneous jobs per tenant; example: 2.
FABRICASSIST_WORKER_TENANT_CONCURRENCY=2
# Concurrency lease duration; example: 300 seconds.
FABRICASSIST_WORKER_CONCURRENCY_LEASE_SECONDS=300
# Maximum upload size in bytes; 12582912 is 12 MiB.
FABRICASSIST_UPLOAD_MAX_BYTES=12582912
# Presigned upload URL lifetime; example: 10 minutes.
FABRICASSIST_UPLOAD_URL_MINUTES=10
# Default maximum completed or pending images in one draft scan. Roles may repeat.
# Maximum images in one scan.
FABRICASSIST_MAX_IMAGES_PER_SCAN=8
# Analysis execution lease; example: 5 minutes.
FABRICASSIST_ANALYSIS_LEASE_MINUTES=5
# Outbox recovery polling interval; example: 30 seconds.
FABRICASSIST_PUBLICATION_RECOVERY_INTERVAL_SECONDS=30
# Maximum outbox rows claimed per recovery pass; example: 100.
FABRICASSIST_PUBLICATION_RECOVERY_BATCH_SIZE=100
# Maximum transient object-deletion attempts; example: 5.
FABRICASSIST_DELETION_MAX_ATTEMPTS=5

# Provider options are independent: evidence, care planner, chat, and product
# information each accept mock, with gemini/openai_responses available only for
# the capabilities implemented by that adapter. The mock makes no network calls.
# FABRICASSIST_VISION_PROVIDER is deprecated and ignored; use
# FABRICASSIST_EVIDENCE_PROVIDER instead.
# Vision analysis defaults to a deterministic local mock: it makes no network calls and
# returns an explicit review-needed result. To use any real provider, put credentials
# only in the ignored .env file; never commit or paste secrets into chat.
# Evidence adapter: mock, gemini, or openai_responses.
FABRICASSIST_EVIDENCE_PROVIDER=mock
# Care-planning adapter: mock, gemini, or openai_responses.
FABRICASSIST_CARE_PLANNER_PROVIDER=mock
# Conversation adapter: mock, gemini, or openai_responses.
FABRICASSIST_CHAT_PROVIDER=mock
# The same S3 adapter targets MinIO locally, AWS S3 in AWS, or R2 in alpha.
# Object storage options: s3 (MinIO locally, AWS S3 or R2 remotely).
# Object storage adapter: s3 (MinIO, AWS S3, or R2).
FABRICASSIST_OBJECT_STORAGE_BACKEND=s3
# FABRICASSIST_OPENAI_RESPONSES_BASE_URL=https://your-openai-compatible-host/v1
# FABRICASSIST_OPENAI_RESPONSES_API_KEY=replace-with-your-secret
# FABRICASSIST_OPENAI_RESPONSES_MODEL=vision-capable-model-id
# Optional JSON object of gateway-specific headers. Keep values in ignored .env.
# FABRICASSIST_OPENAI_RESPONSES_EXTRA_HEADERS_JSON='{"X-Gateway-Subscription-Key":"replace-with-secret"}'
# Reasoning-capable models can require longer than a conventional HTTP request.
# Vision request timeout; example: 120 seconds.
FABRICASSIST_VISION_TIMEOUT_SECONDS=120
# Responses models may use output tokens for internal reasoning before emitting
# the small structured extraction. Keep this at the provider-supported maximum.
# Maximum model input tokens; provider-dependent.
FABRICASSIST_VISION_MAX_INPUT_TOKENS=128000
# Maximum model output tokens; provider-dependent.
FABRICASSIST_VISION_MAX_OUTPUT_TOKENS=16000
# Opt-in local diagnostics: logs the prompt, safe normalized-image metadata, and
# model text output. It never logs image bytes, API keys, headers, or endpoints.
# Unsafe local diagnostics: true or false; keep false outside local.
FABRICASSIST_VISION_DEBUG_LOGGING=false

# Google Gemini Developer API. The Google-specific key and model stay isolated
# from the generic OpenAI-compatible adapter settings.
# FABRICASSIST_EVIDENCE_PROVIDER=gemini
# Gemini API credential; keep empty for mock providers and set only in ignored
# environment/secret storage when using a Gemini capability adapter.
FABRICASSIST_GEMINI_API_KEY=
# Gemini model identifier; example: gemini-2.5-flash.
FABRICASSIST_GEMINI_MODEL=gemini-2.5-flash

# Trusted product catalog defaults to the deterministic no-network fixture. The
# HTTP adapter requires HTTPS and an explicit comma-separated host allow-list.
# Product-information providers are intentionally separate from model providers:
# mock (deterministic, no network) or http_json (allow-listed HTTPS catalog).
# Gemini/OpenAI values apply only to evidence, care planning, and chat.
FABRICASSIST_PRODUCT_INFORMATION_PROVIDER=mock
# FABRICASSIST_PRODUCT_HTTP_JSON_BASE_URL=https://catalog.example/products
# FABRICASSIST_PRODUCT_HTTP_JSON_ALLOWED_HOSTS=catalog.example
# FABRICASSIST_PRODUCT_HTTP_JSON_API_KEY=replace-with-secret
# Catalog HTTP timeout; example: 10 seconds.
FABRICASSIST_PRODUCT_HTTP_JSON_TIMEOUT_SECONDS=10
# Catalog response limit; 262144 is 256 KiB.
FABRICASSIST_PRODUCT_HTTP_JSON_MAX_RESPONSE_BYTES=262144
# Durable product lookup cache lifetime; example: 1440 minutes.
FABRICASSIST_PRODUCT_CACHE_MINUTES=1440

# Generic OpenAI Responses-compatible gateway example. The provider stays agnostic:
# change only these settings to use a different Responses-compatible gateway/model.
# FABRICASSIST_EVIDENCE_PROVIDER=openai_responses
# FABRICASSIST_OPENAI_RESPONSES_BASE_URL=https://your-gateway.example/openai/v1
# FABRICASSIST_OPENAI_RESPONSES_API_KEY=replace-with-your-secret
# FABRICASSIST_OPENAI_RESPONSES_MODEL=your-vision-model-id
# FABRICASSIST_OPENAI_RESPONSES_EXTRA_HEADERS_JSON='{"X-Gateway-Subscription-Key":"replace-with-secret"}'

# PostgreSQL is authoritative for business state, checkpoints, outboxes, and durable caches.
# These values point at the Compose service; change them for any shared environment.
# Compose PostgreSQL database name; example: fabricassist_dev.
FABRICASSIST_POSTGRES_DB=fabricassist_dev
# Compose PostgreSQL username; local only.
FABRICASSIST_POSTGRES_USER=fabricassist_dev
# Compose PostgreSQL password; replace outside local.
FABRICASSIST_POSTGRES_PASSWORD=change-me-local-postgres
# Host PostgreSQL port; example: 5432.
FABRICASSIST_POSTGRES_PORT=5432
# Isolated Compose migration-test database; do not use it for application data.
# Separate migration-test PostgreSQL port; example: 5433.
FABRICASSIST_POSTGRES_TEST_PORT=5433
# Runtime PostgreSQL URL; authoritative state and outboxes.
FABRICASSIST_DATABASE_URL=postgresql://fabricassist_dev:change-me-local-postgres@fabricassist-postgres:5432/fabricassist_dev
# Optional direct migration URL; empty means use DATABASE_URL.
FABRICASSIST_DATABASE_MIGRATION_URL=
# SQLAlchemy pool size, overflow, recycle, and startup retry defaults.
FABRICASSIST_DATABASE_POOL_SIZE=5
FABRICASSIST_DATABASE_MAX_OVERFLOW=10
FABRICASSIST_DATABASE_POOL_RECYCLE_SECONDS=-1
FABRICASSIST_DATABASE_CONNECT_ATTEMPTS=1
FABRICASSIST_DATABASE_CONNECT_RETRY_SECONDS=0

# Valkey backs selected transient capabilities in local Docker. It uses no
# authentication only in this isolated development stack.
# Configure authentication and TLS outside development.
# Host Valkey port; example: 6379.
FABRICASSIST_VALKEY_PORT=6379
# Valkey URL for transient adapters; unused when backend=noop.
FABRICASSIST_VALKEY_URL=valkey://fabricassist-valkey:6379/0
# Celery broker configuration is intentionally independent from general Valkey use.
# Replace this URL with amqp(s):// to adopt RabbitMQ without application changes.
# Independent Celery broker URL; Redis or amqp(s) are supported.
FABRICASSIST_CELERY_BROKER_URL=redis://fabricassist-valkey:6379/0
# QStash settings are empty in the local Celery topology; required only when
# FABRICASSIST_JOB_DISPATCHER=qstash.
FABRICASSIST_QSTASH_TOKEN=
FABRICASSIST_QSTASH_CURRENT_SIGNING_KEY=
FABRICASSIST_QSTASH_NEXT_SIGNING_KEY=
FABRICASSIST_QSTASH_DESTINATION_URL=
# Hot-cache TTL; example: 86400 seconds.
FABRICASSIST_CACHE_HOT_TTL_SECONDS=86400
FABRICASSIST_GRAPHQL_MAX_DEPTH=8
FABRICASSIST_GRAPHQL_MAX_TOKENS=1500
FABRICASSIST_GRAPHQL_MAX_ALIASES=20

# MinIO is the local private S3-compatible object store. Replace credentials
# outside isolated local development; AWS workload identity may omit keys.
# Server-side S3 endpoint; MinIO, AWS S3, or R2.
FABRICASSIST_S3_ENDPOINT_URL=http://fabricassist-minio:9000
# Browser-reachable S3 endpoint used only in presigned URLs.
# Browser-reachable endpoint used in presigned URLs.
FABRICASSIST_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# S3 region; local default is us-east-1, R2 uses auto.
FABRICASSIST_S3_REGION=us-east-1
# S3 access key; optional with AWS workload identity and always secret.
FABRICASSIST_S3_ACCESS_KEY=fabricassist-local
# S3 secret key; optional with AWS workload identity and always secret.
FABRICASSIST_S3_SECRET_KEY=change-me-local-minio
# Private S3 bucket name; example: fabricassist-local.
FABRICASSIST_S3_BUCKET=fabricassist-local
# S3 addressing: true for MinIO, false for R2/AWS normally.
FABRICASSIST_S3_FORCE_PATH_STYLE=true
# Host MinIO API port; example: 9000.
FABRICASSIST_MINIO_API_PORT=9000
# Host MinIO console port; example: 9001.
FABRICASSIST_MINIO_CONSOLE_PORT=9001
# Isolated MinIO endpoint used by Compose-backed integration tests.
# Isolated MinIO integration-test port; example: 9002.
FABRICASSIST_MINIO_TEST_PORT=9002

# Local API values for the Phase 2 backend and Phase 3 Expo diagnostics.
# Change the public URL for a device, web host, or any non-local environment.
# Host API port; example: 8000.
FABRICASSIST_API_PORT=8000

# Optional live/contract smoke inputs. These are never required by default
# tests and must only be set in an ignored local environment or CI secrets.
# Alpha API smoke target and credentials (required only for hosted smoke).
# FABRICASSIST_RELEASE_API_URL=https://api.example.invalid
# FABRICASSIST_ALPHA_SMOKE_EMAIL=smoke-user@example.invalid
# FABRICASSIST_ALPHA_SMOKE_PASSWORD=replace-with-smoke-password
FABRICASSIST_ALPHA_SMOKE_TIMEOUT_SECONDS=180
# Optional live Neon smoke switch and URLs (set NEON_SMOKE=1 only explicitly).
FABRICASSIST_NEON_SMOKE=0
# FABRICASSIST_NEON_RUNTIME_URL=postgresql://...
# FABRICASSIST_NEON_MIGRATION_URL=postgresql://...
# Optional live R2 contract smoke switch and protected values.
FABRICASSIST_R2_SMOKE=0
# FABRICASSIST_R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
# FABRICASSIST_R2_REGION=auto
# FABRICASSIST_R2_BUCKET=fabricassist-contract-test
# FABRICASSIST_R2_ACCESS_KEY=replace-with-r2-key
# FABRICASSIST_R2_SECRET_KEY=replace-with-r2-secret
# FABRICASSIST_R2_TEST_PREFIX=contract-smoke/

# Inactive until the coordinated Phase 10 cutover; defaults to no-network mock.
FABRICASSIST_GARMENT_ANALYSIS_PROVIDER=mock
# Optional stain-treatment proposal branch; keep disabled until the v2 workflow
# is explicitly composed and reviewed. It never changes the legacy route.
FABRICASSIST_GARMENT_ANALYSIS_STAIN_ENABLED=false
# Optional branch-specific overrides; fall back to the configured provider model.
# FABRICASSIST_GARMENT_ANALYSIS_GEMINI_MODEL=gemini-2.5-flash
# FABRICASSIST_GARMENT_ANALYSIS_OPENAI_MODEL=vision-capable-model-id
