# USB Android development overrides.
# Copy to .env.android. The Make target also loads .env.local first.
# For wireless Android, replace localhost with the workstation LAN IP and use
# ANDROID_EXPO_FLAGS=--lan when starting Metro.

FABRICASSIST_API_PUBLIC_URL=http://localhost:58000
FABRICASSIST_S3_PUBLIC_ENDPOINT_URL=http://localhost:59000
EXPO_PUBLIC_FABRICASSIST_API_URL=http://localhost:58000
EXPO_PUBLIC_FABRICASSIST_ENVIRONMENT=development
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
