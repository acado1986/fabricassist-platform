# Local environment and secrets
.env
.env.*
.env-*
!.env.example
!.env.alpha.example
!.env.production.example
!.env.android.example

# Never retain provider dashboard exports or copied credentials in alpha docs.
docs/alpha/credentials/

# Python (Phase 2 and later)
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.venv/
dist/
build/
*.egg-info/

# Node and Expo (Phase 3 and later)
node_modules/
.expo/
.turbo/
coverage/
web-build/
frontend/playwright-report/
frontend/test-results/
frontend/apps/client/android/
frontend/apps/client/ios/

# OpenTofu local state and plans; keep dependency lockfiles and examples.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local Docker and tool output
*.log
tmp/
