# FabricAssist hosted alpha configuration template.
# Copy to an ignored .env file or configure the same values in the provider dashboard.
# Replace every value marked <required>; never commit live credentials.

FABRICASSIST_ENVIRONMENT=alpha
FABRICASSIST_DEPLOYMENT_PROFILE=alpha
FABRICASSIST_JOB_DISPATCHER=qstash

FABRICASSIST_ACCESS_TOKEN_SECRET=<required-generated-secret-at-least-32-characters>
FABRICASSIST_APP_BASE_URL=https://app.example.invalid
FABRICASSIST_API_PUBLIC_URL=https://api.example.invalid
FABRICASSIST_CORS_ALLOWED_ORIGINS=https://app.example.invalid

# Use Neon pooled runtime and direct migration URLs. The migration URL is not used yet.
FABRICASSIST_DATABASE_URL=postgresql://user:<required-password>@host.example.invalid/database?sslmode=require
FABRICASSIST_DATABASE_MIGRATION_URL=postgresql://user:<required-password>@host.example.invalid/database?sslmode=require

# Use the private Cloudflare R2 S3 endpoint and the browser-reachable endpoint.
FABRICASSIST_S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
FABRICASSIST_S3_PUBLIC_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
FABRICASSIST_S3_REGION=auto
FABRICASSIST_S3_BUCKET=fabricassist-alpha
FABRICASSIST_S3_FORCE_PATH_STYLE=false
# FABRICASSIST_S3_ACCESS_KEY=<required-r2-access-key>
# FABRICASSIST_S3_SECRET_KEY=<required-r2-secret-key>

# Configure these manually; no QStash credential belongs in this repository.
# FABRICASSIST_QSTASH_TOKEN=<required-qstash-token>
# FABRICASSIST_QSTASH_CURRENT_SIGNING_KEY=<required-current-signing-key>
# FABRICASSIST_QSTASH_NEXT_SIGNING_KEY=<required-next-signing-key>
FABRICASSIST_QSTASH_DESTINATION_URL=https://api.example.invalid/internal/jobs/qstash

FABRICASSIST_MAX_IMAGES_PER_SCAN=3
FABRICASSIST_VISION_MAX_CONCURRENCY=1
FABRICASSIST_JOB_STAGE_BUDGET_SECONDS=75
FABRICASSIST_DEFAULT_IMAGE_RETENTION_DAYS=7

# Keep the deterministic provider unless an opt-in provider is configured manually.
FABRICASSIST_VISION_PROVIDER=mock
