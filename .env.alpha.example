# FabricAssist hosted alpha configuration template.
# Copy to an ignored .env file or configure the same values in the provider dashboard.
# Replace every value marked <required>; never commit live credentials.

# Runtime environment: development, alpha, or production.
FABRICASSIST_ENVIRONMENT=alpha
# Deployment topology: local, alpha, or production.
FABRICASSIST_DEPLOYMENT_PROFILE=alpha
# Job options: celery (Valkey/RabbitMQ worker) | qstash (signed HTTP).
# Alpha dispatches through signed QStash HTTP delivery. It does not run Celery.
# Job transport: celery or qstash.
FABRICASSIST_JOB_DISPATCHER=qstash
# Optional capability options: valkey | noop. Alpha has no Valkey service, so
# disable these explicitly. Production should use real distributed controls.
# These are not production settings: production requires distributed controls.
# Hot-cache backend: valkey or noop.
FABRICASSIST_HOT_CACHE_BACKEND=noop
# Rate limiter backend: valkey or noop.
FABRICASSIST_RATE_LIMITER_BACKEND=noop
# Concurrency gate backend: valkey or noop.
FABRICASSIST_CONCURRENCY_GATE_BACKEND=noop

# JWT signing secret; use a random 32+ character value outside local development.
FABRICASSIST_ACCESS_TOKEN_SECRET=<required-generated-secret-at-least-32-characters>
# Frontend origin used for links and CORS; example: http://localhost:8081.
FABRICASSIST_APP_BASE_URL=https://app.example.invalid
# Public API base URL; example: http://localhost:8000.
FABRICASSIST_API_PUBLIC_URL=https://api.example.invalid
# Comma-separated browser origins; never use * in hosted environments.
FABRICASSIST_CORS_ALLOWED_ORIGINS=https://app.example.invalid
# Alpha access/refresh and request policy defaults.
FABRICASSIST_ACCESS_TOKEN_MINUTES=15
FABRICASSIST_REFRESH_TOKEN_DAYS=14
FABRICASSIST_METRICS_ENABLED=true
FABRICASSIST_METRICS_ACCESS_TOKEN=<optional-metrics-bearer-token>
FABRICASSIST_OTEL_EXPORTER_OTLP_ENDPOINT=
FABRICASSIST_OTEL_SERVICE_NAME=fabricassist-api
FABRICASSIST_RATE_LIMIT_ENABLED=true
FABRICASSIST_RATE_LIMIT_FAIL_OPEN=false
FABRICASSIST_RATE_LIMIT_GLOBAL_PER_MINUTE=600
FABRICASSIST_RATE_LIMIT_AUTH_PER_MINUTE=10
FABRICASSIST_RATE_LIMIT_ANALYSIS_PER_MINUTE=10
FABRICASSIST_RATE_LIMIT_CHAT_PER_MINUTE=20
FABRICASSIST_CONVERSATION_RECENT_MESSAGE_LIMIT=12
FABRICASSIST_CONVERSATION_RELEVANT_IMAGE_LIMIT=8
FABRICASSIST_WORKER_GLOBAL_CONCURRENCY=8
FABRICASSIST_WORKER_TENANT_CONCURRENCY=2
FABRICASSIST_WORKER_CONCURRENCY_LEASE_SECONDS=300

# Use Neon pooled runtime and direct migration URLs. Alembic uses the direct URL.
# Runtime PostgreSQL URL; authoritative state and outboxes.
FABRICASSIST_DATABASE_URL=postgresql://user:<required-password>@host.example.invalid/database?sslmode=require
# Direct PostgreSQL URL used for migrations; alpha only.
FABRICASSIST_DATABASE_MIGRATION_URL=postgresql://user:<required-password>@host.example.invalid/database?sslmode=require
FABRICASSIST_DATABASE_POOL_SIZE=2
FABRICASSIST_DATABASE_MAX_OVERFLOW=1
FABRICASSIST_DATABASE_POOL_RECYCLE_SECONDS=300
FABRICASSIST_DATABASE_CONNECT_ATTEMPTS=3
FABRICASSIST_DATABASE_CONNECT_RETRY_SECONDS=1

# R2 is selected through the same S3 adapter used by local MinIO and AWS S3.
# Keep both endpoints HTTPS and keep access keys in protected provider settings.
# Server-side S3 endpoint; MinIO, AWS S3, or R2.
FABRICASSIST_S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
# Browser-reachable endpoint used in presigned URLs.
FABRICASSIST_S3_PUBLIC_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
# S3 region; use auto for R2, us-east-1 for many local/AWS setups.
FABRICASSIST_S3_REGION=auto
# Private S3 bucket name; example: fabricassist-local.
FABRICASSIST_S3_BUCKET=fabricassist-alpha
# S3 addressing: true for MinIO, false for R2/AWS normally.
FABRICASSIST_S3_FORCE_PATH_STYLE=false
# FABRICASSIST_S3_ACCESS_KEY=<required-r2-access-key>
# FABRICASSIST_S3_SECRET_KEY=<required-r2-secret-key>

# Configure these manually in Render/GitHub protected settings; no QStash
# credential belongs in this repository or in frontend variables.
# FABRICASSIST_QSTASH_TOKEN=<required-qstash-token>
# FABRICASSIST_QSTASH_CURRENT_SIGNING_KEY=<required-current-signing-key>
# FABRICASSIST_QSTASH_NEXT_SIGNING_KEY=<required-next-signing-key>
# QStash signed delivery URL; alpha only, no embedded credentials.
FABRICASSIST_QSTASH_DESTINATION_URL=https://api.example.invalid/internal/jobs/qstash

# Maximum images in one scan.
FABRICASSIST_MAX_IMAGES_PER_SCAN=3
# Maximum parallel vision calls; example: 1 for alpha.
FABRICASSIST_VISION_MAX_CONCURRENCY=1
# Maximum seconds per analysis stage; example: 75.
FABRICASSIST_JOB_STAGE_BUDGET_SECONDS=75
# Outbox recovery polling interval; example: 30 seconds.
FABRICASSIST_PUBLICATION_RECOVERY_INTERVAL_SECONDS=30
# Maximum outbox rows claimed per recovery pass; example: 100.
FABRICASSIST_PUBLICATION_RECOVERY_BATCH_SIZE=100
# Maximum transient object-deletion attempts; example: 5.
FABRICASSIST_DELETION_MAX_ATTEMPTS=5
# Image retention period in days; example: 7.
FABRICASSIST_DEFAULT_IMAGE_RETENTION_DAYS=7
# Upload and cache policy defaults; alpha limits are enforced by Settings.
FABRICASSIST_UPLOAD_MAX_BYTES=12582912
FABRICASSIST_UPLOAD_URL_MINUTES=10
FABRICASSIST_ANALYSIS_LEASE_MINUTES=5
FABRICASSIST_CACHE_HOT_TTL_SECONDS=86400
FABRICASSIST_GRAPHQL_MAX_DEPTH=8
FABRICASSIST_GRAPHQL_MAX_TOKENS=1500
FABRICASSIST_GRAPHQL_MAX_ALIASES=20

# Provider options are independent. Each supports mock; evidence/planning/chat
# may additionally use a registered gemini or openai_responses adapter when its
# adapter-specific credentials are configured. Mock adapters make no hosted calls
# and are the default for alpha smoke tests.
# FABRICASSIST_VISION_PROVIDER is deprecated and ignored; use
# FABRICASSIST_EVIDENCE_PROVIDER instead.
# Select Gemini/OpenAI Responses only with separately approved credentials.
# Evidence adapter: mock, gemini, or openai_responses.
FABRICASSIST_EVIDENCE_PROVIDER=mock
# Keep the optional v2 stain proposal branch disabled until its rollout gate.
FABRICASSIST_GARMENT_ANALYSIS_STAIN_ENABLED=false
# Care-planning adapter: mock, gemini, or openai_responses.
FABRICASSIST_CARE_PLANNER_PROVIDER=mock
# Conversation adapter: mock, gemini, or openai_responses.
FABRICASSIST_CHAT_PROVIDER=mock
# Object storage options: s3 (R2 here; the same adapter also supports MinIO/AWS).
# Object storage adapter: s3 (MinIO, AWS S3, or R2).
FABRICASSIST_OBJECT_STORAGE_BACKEND=s3
# Product-information providers are intentionally separate from model providers:
# mock (deterministic, no network) or http_json (allow-listed HTTPS catalog).
# Gemini/OpenAI values apply only to evidence, care planning, and chat.
FABRICASSIST_PRODUCT_INFORMATION_PROVIDER=mock

# Optional model/product adapter configuration. Leave credentials empty when
# using mock providers; these values are examples only.
# Gemini Developer API key; configure in Render/GitHub secrets only when a
# capability selector is changed to gemini. Never commit the real key.
FABRICASSIST_GEMINI_API_KEY=
FABRICASSIST_GEMINI_MODEL=gemini-2.5-flash
# FABRICASSIST_OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
# FABRICASSIST_OPENAI_RESPONSES_API_KEY=<openai-api-key>
# FABRICASSIST_OPENAI_RESPONSES_MODEL=<vision-capable-model>
# FABRICASSIST_OPENAI_RESPONSES_EXTRA_HEADERS_JSON={}
FABRICASSIST_VISION_TIMEOUT_SECONDS=120
FABRICASSIST_VISION_MAX_INPUT_TOKENS=128000
FABRICASSIST_VISION_MAX_OUTPUT_TOKENS=16000
FABRICASSIST_VISION_DEBUG_LOGGING=false
# FABRICASSIST_PRODUCT_HTTP_JSON_BASE_URL=https://catalog.example.invalid/products
# FABRICASSIST_PRODUCT_HTTP_JSON_API_KEY=<catalog-api-key>
# FABRICASSIST_PRODUCT_HTTP_JSON_ALLOWED_HOSTS=catalog.example.invalid
FABRICASSIST_PRODUCT_HTTP_JSON_TIMEOUT_SECONDS=10
FABRICASSIST_PRODUCT_HTTP_JSON_MAX_RESPONSE_BYTES=262144
FABRICASSIST_PRODUCT_CACHE_MINUTES=1440

# Hosted smoke credentials are protected CI/Render values, not application
# credentials. Set these only in an ignored env file when running the smoke.
FABRICASSIST_RELEASE_API_URL=https://api.example.invalid
FABRICASSIST_RELEASE_SMOKE_EMAIL=<required-smoke-user-email>
FABRICASSIST_RELEASE_SMOKE_PASSWORD=<required-smoke-user-password>
FABRICASSIST_RELEASE_SMOKE_TIMEOUT_SECONDS=180

# Optional live integration checks; disabled by default to prevent paid calls.
FABRICASSIST_NEON_SMOKE=0
FABRICASSIST_R2_SMOKE=0
# FABRICASSIST_NEON_RUNTIME_URL=postgresql://...
# FABRICASSIST_NEON_MIGRATION_URL=postgresql://...
# FABRICASSIST_R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
# FABRICASSIST_R2_REGION=auto
# FABRICASSIST_R2_BUCKET=fabricassist-contract-test
# FABRICASSIST_R2_ACCESS_KEY=<required-r2-access-key>
# FABRICASSIST_R2_SECRET_KEY=<required-r2-secret-key>
# FABRICASSIST_R2_TEST_PREFIX=contract-smoke/
