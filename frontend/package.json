{
  "name": "fabricassist-frontend",
  "version": "1.4.2",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.9": "5.0.9",
      "uuid@<11.1.1": "11.1.1",
      "js-yaml": ">=4.3.0"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js --runInBand",
    "test:e2e": "playwright test",
    "test:android:smoke": "maestro test e2e/maestro/customer-smoke.yaml",
    "build:android:release": "pnpm --filter fabricassist-app exec expo prebuild --platform android --clean && cd apps/client/android && ./gradlew bundleRelease",
    "build:ios:release": "pnpm --filter fabricassist-app exec expo prebuild --platform ios --clean && cd apps/client/ios && xcodebuild -workspace FabricAssist.xcworkspace -scheme FabricAssist -configuration Release archive",
    "build:web": "pnpm --filter fabricassist-app exec expo export --platform web",
    "generate:api": "pnpm --filter @fabricassist/api-client generate",
    "check:api": "pnpm generate:api && git diff --exit-code -- packages/api-client/src/generated",
    "generate:graphql": "graphql-codegen --config codegen.ts && prettier --write packages/api-client/src/graphql/generated",
    "generate:graphql:watch": "graphql-codegen --config codegen.ts --watch",
    "check:graphql": "pnpm generate:graphql && git diff --exit-code -- packages/api-client/src/graphql/generated"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-inspector/cli": "^7.0.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-expo": "^57.0.2",
    "graphql": "^17.0.2",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
